# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Gere uma chave longa e aleatória para assinar as sessões.
SESSION_SECRET=troque-por-uma-chave-com-pelo-menos-24-caracteres

# Chave usada apenas uma vez para criar o primeiro administrador.
ADMIN_SETUP_KEY=troque-por-uma-chave-secreta
